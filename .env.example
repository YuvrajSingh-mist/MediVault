# ---------------------------------------------------------------------------
# MediVault - web app configuration (Firebase Web SDK)
# Copy this file to `.env.local` for local development and to `.env.production`
# (or `.env`) before `npm run build` for the deployed site.
#
# These values are PUBLIC by design (they are shipped to the browser). Access to
# data is controlled by Firebase Security Rules + Auth, not by secrecy of these
# keys. Get them with:
#   firebase apps:sdkconfig web
# or from Firebase console -> Project settings -> Your apps -> Web app.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate (VAPID) key - Firebase console -> Cloud Messaging ->
# Web Push certificates. Optional: without it the app uses in-app alerts only.
VITE_FIREBASE_VAPID_KEY=

# `true`  -> talk to the local Firebase Emulator Suite (default on localhost)
# `false` -> talk to the real Google Cloud project
VITE_USE_EMULATORS=true

# `true`  -> reach the emulators through the Vite dev server (single origin on
#            port 5173) instead of ports 9099/8080/5001/9199. Only needed when a
#            browser or network policy blocks extra localhost ports.
VITE_EMULATOR_PROXY=false

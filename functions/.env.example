# ---------------------------------------------------------------------------
# MediVault - Cloud Functions environment (copy to functions/.env)
#
# Pick ONE transport. Anything left empty falls back to the `mailOutbox`
# collection, where the message is stored with status "logged" and is NOT
# delivered.
# ---------------------------------------------------------------------------

# --- Option A: SMTP (works with a free Gmail account) ----------------------
# Google account -> Security -> 2-Step Verification -> App passwords.
# Generate one for "Mail", then paste the 16 characters below with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Option B: SendGrid ----------------------------------------------------
# Settings -> API Keys. The sender below must be a verified sender identity.
SENDGRID_API_KEY=

# Sender shown in the inbox. Required for SendGrid, optional for SMTP.
MAIL_FROM=MediVault <you@gmail.com>

# Public URL of the deployed app, used in email links.
APP_URL=https://medivault-gcp-23875.web.app

# Optional: minimum minutes between two dose reminders (default 5).
REMINDER_WINDOW_MINUTES=5

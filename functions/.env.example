# ---------------------------------------------------------------------------
# MediVault - Cloud Functions environment (copy to functions/.env)
#
# Only SENDGRID_API_KEY is required for real email delivery. Without it the
# reminder engine still runs, but messages are written to the `mailOutbox`
# collection with status "logged" so the flow can be demonstrated offline.
# ---------------------------------------------------------------------------

# SendGrid API key (Settings -> API Keys). Leave empty to log emails instead.
SENDGRID_API_KEY=

# Verified sender identity in SendGrid.
MAIL_FROM=MediVault <reminders@medivault.example.com>

# Public URL of the deployed app, used in email links.
APP_URL=http://localhost:5173

# Optional: minimum minutes between two dose reminders (default 5).
REMINDER_WINDOW_MINUTES=5

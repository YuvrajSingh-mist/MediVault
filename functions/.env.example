# ---------------------------------------------------------------------------
# MediVault - Cloud Functions environment (copy to functions/.env)
#
# Only the three TWILIO_* values are needed for real SMS delivery. Without them
# the reminder engine still runs, but messages are written to the `smsOutbox`
# collection with status "logged" so the flow can be demonstrated offline.
# ---------------------------------------------------------------------------

# Twilio (Console -> Account Info, and a sending number under Phone Numbers).
# Leave empty to log messages instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Public URL of the deployed app, used as the link inside every message.
APP_URL=http://localhost:5173

# Optional: minimum minutes between two dose reminders (default 5).
REMINDER_WINDOW_MINUTES=5

# Cloud Storage bucket that prescriptions are uploaded to. Pinned explicitly so
# the storage trigger and the health check agree with the web app.
STORAGE_BUCKET=medivault-gcp-23875-files
